public class TP_Util {
    public static double factorial(int n) {
        double f = 1.0;

        for (int i = 2; i <= n; i++) {
            f *= i
        }

        return f
    } 

    public static double poisson(int k, double lambda) {
        return Math.exp(-lambda) * Math.pow(lambda, k) / factorial(k);
    }
}